<span id="main-content" tabindex="-1"></span>
<div class="flex items-center justify-center h-screen bg-gray-100">
  <div class="bg-white rounded-lg shadow p-8 max-w-md text-center">
    <%= if @view == :confirm do %>
      <h1 class="text-xl font-semibold mb-2"><%= gettext("Unirte al grupo") %></h1>
      <p class="text-gray-600 mb-6">
        <%= gettext("¿Seguro que quieres unirte al grupo «%{group_name}»?", group_name: @group_name) %>
      </p>
      <div class="flex justify-center gap-3">
        <button
          type="button"
          phx-click="cancel_join"
          class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300"
        >
          <%= gettext("Cancelar") %>
        </button>
        <button
          type="button"
          phx-click="confirm_join"
          class="px-4 py-2 rounded bg-sky-500 text-white hover:bg-sky-600"
        >
          <%= gettext("Unirme") %>
        </button>
      </div>
    <% else %>
      <h1 class="text-xl font-semibold mb-2"><%= gettext("Enlace de invitación") %></h1>
      <p class="text-gray-600"><%= @error_message %></p>
      <a href="/chat" class="inline-block mt-4 text-blue-600 underline">
        <%= gettext("Ir a Pomoroom") %>
      </a>
    <% end %>
  </div>
</div>
