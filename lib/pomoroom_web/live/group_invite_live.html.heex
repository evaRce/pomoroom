<span id="main-content" tabindex="-1"></span>
<div class="flex items-center justify-center h-screen bg-gray-100">
  <div class="bg-white rounded-lg shadow p-8 max-w-md text-center">
    <h1 class="text-xl font-semibold mb-2"><%= gettext("Enlace de invitación") %></h1>
    <p class="text-gray-600"><%= @error_message %></p>
    <a href="/chat" class="inline-block mt-4 text-blue-600 underline">
      <%= gettext("Ir a Pomoroom") %>
    </a>
  </div>
</div>
